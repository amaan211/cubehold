# Copy to .env (loaded by `pnpm dev` via tsx --env-file) or export in your shell.

# Where the panel listens. Keep 127.0.0.1 unless you put it behind a reverse proxy.
HOST=127.0.0.1
PORT=4000

# Directory for the SQLite DB, servers, backups and downloaded JDKs.
# DATA_DIR=./data

# Mark cookies Secure when served over HTTPS.
# SECURE_COOKIES=true

