{
  "name": "@cubehold/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "agent:status": "tsx src/cli.ts agent status",
    "agent:stop": "tsx src/cli.ts agent stop"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@libsql/client": "^0.18.0",
    "@cubehold/agent": "workspace:*",
    "@cubehold/mc": "workspace:*",
    "@cubehold/providers": "workspace:*",
    "@cubehold/shared": "workspace:*",
    "@cubehold/tunnels": "workspace:*",
    "@trpc/server": "^11.19.0",
    "argon2": "^0.45.1",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.5",
    "pino-pretty": "^13.1.3",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "exports": {
    "./router": {
      "types": "./src/trpc/router.ts",
      "default": "./src/trpc/router.ts"
    }
  }
}
